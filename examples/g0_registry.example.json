{
  "$schema": "https://g0.kongmin.ccwu.cc/schema/manifest-v2.json",
  "version": "2.0",
  "project": "example/demo",
  "binding": { "path": ["demo"], "priority": 10 },
  "tier_policy": "auto",
  "domain": "engineering",
  "domain_weight": 1.0,
  "sources": [
    { "id": "passport", "kind": "file", "path": "docs/passport.md", "tiers": ["standard", "heavy"], "min_size": 100 },
    { "id": "daily", "kind": "file", "path": "docs/daily.md", "tiers": ["heavy"], "recency_hours": 72 },
    { "id": "pb", "kind": "mcp", "endpoint": "gate://pb/recent", "tiers": ["lite", "standard", "heavy"], "limit": 20 }
  ],
  "conflict_resolution": "priority-desc-then-freshness",
  "updated_at": "2026-08-13T12:00:00Z"
}
